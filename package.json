{
    "name": "order-processor",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "vite dev --open --host",
        "sync-ds": "rsync -a --delete ../../dropout-design-system/src/lib/ ./src/lib/ds/",
        "build": "vite build",
        "preview": "bun run build && wrangler dev",
        "deploy": "bun run build && wrangler deploy",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ds": "node --test src/lib/ds/button-contract.test.js src/lib/ds/input-contract.test.js",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "cf-typegen": "wrangler types",
        "db:generate": "drizzle-kit generate",
        "db:push": "drizzle-kit push",
        "db:pull": "drizzle-kit pull",
        "db:studio": "drizzle-kit studio",
        "db:check": "drizzle-kit check",
        "db:migrate": "wrangler d1 migrations apply order_processor --remote",
        "db:migrate:local": "wrangler d1 migrations apply order_processor --local",
        "seed": "wrangler d1 execute order_processor --local --file ./seed/seed.sql",
        "db:migrate:list": "wrangler d1 migrations list order_processor --local"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@sveltejs/adapter-cloudflare": "^7.2.9",
        "@sveltejs/kit": "^2.70.2",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.2.0",
        "@types/papaparse": "^5.5.2",
        "drizzle-kit": "0.31.10",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^17.11.0",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "svelte": "5.56.9",
        "svelte-check": "^4.7.6",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "wrangler": "^4.156.1"
    },
    "dependencies": {
        "@better-auth/passkey": "^1.7.15",
        "@lucide/svelte": "^1.65.0",
        "better-auth": "^1.7.15",
        "bits-ui": "^2.20.2",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.4",
        "gsap": "^3.15.0",
        "papaparse": "^5.7.0",
        "svelte-sonner": "^1.2.2",
        "tailwind-merge": "^3.7.0",
        "tailwind-variants": "^4.0.0",
        "vaul-svelte": "^0.3.2",
        "xlsx": "^0.18.5",
        "zod": "^4.6.6"
    },
    "type": "module"
}
